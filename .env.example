# See CLAUDE.md for the full description of each variable.

PORT=3000
NODE_ENV=development

# Absolute path to the folder containing .mp4 video files.
VIDEOS_DIR=

# When true, POST /videos/selection replays mocks/<key>/*.jsonl instead of
# running the real ML pipeline (see the `demo` module).
APP_DEMO=false

# Postgres connection.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional push-notification fan-out for Groq alerts. PUSHER_SEND=true to enable.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
PUSHER_SEND=false

# Google AI Studio key for the AI chat assistant (`ai` module). If unset,
# POST /ai/chat returns an honest "not configured" reply instead of failing
# to boot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_TIMEOUT_MS=20000
# GEMINI_MAX_OUTPUT_TOKENS=400

# Dry-run switch for the AI chat assistant. When false, the assembled prompt
# is logged but never actually sent to Gemini — use this while iterating on
# prompt content to avoid burning API quota. Defaults to true (real calls)
# when unset.
SEND_PROMPT=true

# Path to the CRIMENO-Model per-session groq_v*.jsonl/vlm_v*.jsonl logs the
# AI chat assistant reads for the currently selected video.
# MODEL_LOGS_DIR=../CRIMENO-Model/logs

# Path to the analytics.json produced by the CRIMENO-Model aggregator.
# ANALYTICS_JSON_PATH=../CRIMENO-Model/analytics.json
